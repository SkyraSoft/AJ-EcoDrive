{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for AJ EcoDrive ERP desktop window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "core:app:allow-exit",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "log:default"
  ]
}
