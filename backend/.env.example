# ==============================================================================
# AJ EcoDrive ERP — Backend Environment Configuration Example
# Copy this file to '.env' and populate with local or production values.
# NEVER commit the actual '.env' file containing secrets or credentials to git.
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development

# Allowed CORS Origins (Comma-separated for multiple origins)
# Defaults to Vite dev server ports
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# MySQL Database Configuration (XAMPP / phpMyAdmin defaults)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ecodrive
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=5000

# JSON Web Token Secret (For upcoming authentication step)
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d
